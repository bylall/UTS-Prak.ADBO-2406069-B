        <mxCell id="n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Aktor&lt;/b&gt;&lt;/span&gt;" vertex="1">
